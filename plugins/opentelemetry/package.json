{
  "name": "seedcord-plugin-opentelemetry",
  "type": "module",
  "version": "0.0.0",
  "description": "Automatic OpenTelemetry support for seedcord",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KTrain5169/seedcord-plugins.git",
